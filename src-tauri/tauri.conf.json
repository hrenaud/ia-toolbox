{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IA Toolbox",
  "version": "0.1.0",
  "identifier": "com.ia-toolbox.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "IA Toolbox", "width": 1080, "height": 740, "minWidth": 360, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}
