{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window may communicate only with the fixed document worker sidecar.",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/document-worker", "sidecar": true, "args": false }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
